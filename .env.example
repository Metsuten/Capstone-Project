# ===========================================================================
# LeadFlow AI - Environment Configuration Template
# ===========================================================================

# 1. Server Port
PORT=5261

# 2. Conda Environment Name (Optional)
CONDA_ENV_NAME=leadflow-ai

# 3. Google Gemini API Key (Required for live AI card scanning & OCR)
# Get a free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# 4. Gmail SMTP Settings (Optional - For real email dispatch)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# 5. Hunter.io API Key (Optional - B2B Email Deliverability)
# Get a free key from: https://hunter.io/
HUNTER_API_KEY=

# 6. SerpAPI Key (Optional - LinkedIn OSINT Search Verification)
# Get a free key from: https://serpapi.com/
SERPAPI_API_KEY=

# 7. Flask Runtime Environment
FLASK_ENV=production
